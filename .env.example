# Browser/build-safe public configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Non-secret build/deploy binding configuration. Set this per environment.
MARKETO_MEDIA_BUCKET_NAME=YOUR_STAGING_MEDIA_BUCKET_NAME

# Server-only runtime configuration. Never expose this through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Protected guest calls. Configure the real values in Sites, never commit them.
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
TURNSTILE_ALLOWED_HOSTNAMES=marketo-kz.sw-valera.chatgpt.site

# Migration tooling only; not used by the browser bundle.
DATABASE_URL=YOUR_POSTGRES_CONNECTION_STRING
