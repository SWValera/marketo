# Required for the reference-data phase. These values are public by design and
# remain protected by RLS; use the publishable key, never a secret/service key.
# Copy this file to ignored `.env.local` for local work and configure the same
# two variable names in Cloudflare Preview and Production environments.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Legacy fallback only while migrating an older Supabase project.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LEGACY_ANON_KEY

# Not required for reference data. Add an elevated key only in a later audited
# server-only phase. Never prefix it with NEXT_PUBLIC and never expose it to UI.
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LEGACY_SERVICE_ROLE_KEY

# Migration tooling only. Never read this variable from application/client code.
# DATABASE_URL=REPLACE_WITH_SERVER_ONLY_POSTGRES_CONNECTION_STRING
