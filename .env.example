# Browser/build-safe public configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_MEDIA_DOMAIN.example

# Server-only runtime configuration. Never expose this through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Migration tooling only; not used by the browser bundle.
DATABASE_URL=YOUR_POSTGRES_CONNECTION_STRING
