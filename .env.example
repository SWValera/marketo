# Browser/build-safe public configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Non-secret build/deploy binding configuration. Set this per environment.
MARKETO_MEDIA_BUCKET_NAME=YOUR_STAGING_MEDIA_BUCKET_NAME

# Server-only runtime configuration. Never expose this through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Protected guest calls. Configure the real values in Sites, never commit them.
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
TURNSTILE_ALLOWED_HOSTNAMES=jevu.kz

# Migration tooling only; not used by the browser bundle.
DATABASE_URL=YOUR_POSTGRES_CONNECTION_STRING

# Moderation runtime vars (Worker bindings, never NEXT_PUBLIC_*).
MODERATION_EXTERNAL_AI_ENABLED=false
MODERATION_AI_PROVIDER=unavailable
MODERATION_AI_MODEL=gpt-5.6-luna
MODERATION_AI_SHADOW_MODE=true
MODERATION_OCR_PROVIDER=unavailable
MODERATION_PERCEPTUAL_HASH_ENABLED=true
# Set a reviewed UTC activation timestamp; never backdate to process old runs.
# MODERATION_AI_ENABLED_SINCE=
# MODERATION_EXTERNAL_PROCESSING_BASIS=
# OPENAI_API_KEY is a Worker secret. No credential or example value here.
