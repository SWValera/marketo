{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketo-staging",
  "keep_vars": true,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "MODERATION_FRAMEWORK_ENABLED": "true",
    "MODERATION_AI_ENABLED": "true",
    "MODERATION_EXTERNAL_AI_ENABLED": "true",
    "MODERATION_AI_MODEL": "gpt-5.6-luna",
    "MODERATION_AI_SHADOW_MODE": "false",
    "MODERATION_PERCEPTUAL_HASH_ENABLED": "true",
    "MODERATION_AI_PROVIDER": "openai",
    "MODERATION_OCR_PROVIDER": "openai_vision_ocr",
    "MODERATION_SMS_ENABLED": "false",
    "MODERATION_SMS_PROVIDER": "unavailable",
    "MODERATION_AUTOMATIC_ENABLED": "true",
    "MODERATION_AUTOMATIC_APPROVAL_ENABLED": "true",
    "MODERATION_AUTOMATIC_REJECTION_ENABLED": "true",
    "MODERATION_AI_ENABLED_SINCE": "2026-09-27T00:00:00.000Z",
    "MODERATION_EXTERNAL_PROCESSING_BASIS": "owner-authorized-closed-testing-2026-09-27"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}
