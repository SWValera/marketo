{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketo-staging",
  "keep_vars": true,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
