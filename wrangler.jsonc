{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketo-staging",
  "keep_vars": true,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "MODERATION_FRAMEWORK_ENABLED": "true",
    "MODERATION_AI_ENABLED": "false",
    "MODERATION_EXTERNAL_AI_ENABLED": "false",
    "MODERATION_AI_MODEL": "gpt-5.6-luna",
    "MODERATION_AI_SHADOW_MODE": "true",
    "MODERATION_PERCEPTUAL_HASH_ENABLED": "true",
    "MODERATION_AI_PROVIDER": "unavailable",
    "MODERATION_OCR_PROVIDER": "unavailable",
    "MODERATION_SMS_ENABLED": "false",
    "MODERATION_SMS_PROVIDER": "unavailable"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}
